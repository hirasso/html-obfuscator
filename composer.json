{
  "name": "hirasso/html-obfuscator",
  "description": "Obfuscate emails, phone numbers, and other sensitive data in PHP — invisible to humans, hidden from bots until they interact.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Rasso Hilber",
      "email": "mail@rassohilber.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Hirasso\\HTMLObfuscator\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/php/"
    }
  },
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "league/commonmark": "^2.8",
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-watch": "^3.0",
    "phpbench/phpbench": "^1.7",
    "phpstan/phpstan": "^2.1",
    "spatie/commonmark-shiki-highlighter": "^2.5",
    "spatie/shiki-php": "^2.4",
    "spatie/typescript-transformer": "^3.3",
    "symfony/console": "^8.1",
    "symfony/var-dumper": ">=6.4"
  },
  "scripts": {
    "format": "./vendor/bin/pint",
    "test": "./vendor/bin/pest",
    "test:watch": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/pest --watch"
    ],
    "test:coverage": "php -d zend_extension=/Applications/Herd.app/Contents/Resources/xdebug/xdebug-84-arm64.so -d xdebug.mode=coverage ./vendor/bin/pest --coverage --coverage-html ./tests/php/reports",
    "test:ci": "./vendor/bin/pest --coverage-clover coverage.xml",
    "analyse": "./vendor/bin/phpstan analyse --memory-limit=2G",
    "demo": [
      "Composer\\Config::disableProcessTimeout",
      "pkill -f 'php -S localhost:8765' || true",
      "php -S localhost:8765 -t demo/"
    ],
    "fixture": [
      "Composer\\Config::disableProcessTimeout",
      "pkill -f 'php -S localhost:8766' || true",
      "php -S localhost:8766 -t tests/e2e/fixtures/"
    ],
    "build": [
      "pnpm build",
      "@generate-types",
      "@generate-readme"
    ],
    "generate-types": "bin/console typescript:transform",
    "generate-readme": "bin/console readme:generate",
    "bench": "./vendor/bin/phpbench run --report=aggregate",
    "generate-fixtures": "bin/console fixtures:generate",
    "post-install-cmd": [
      "[ -n \"$CI\" ] || pnpm install",
      "ln -s AGENTS.md CLAUDE.md || exit 0"
    ],
    "post-update-cmd": [
      "[ -n \"$CI\" ] || pnpm install"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
