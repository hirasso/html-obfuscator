#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Hirasso\HTMLObfuscator\Commands\GenerateFixturesCommand;
use Hirasso\HTMLObfuscator\Commands\GenerateReadmeCommand;
use Hirasso\HTMLObfuscator\Commands\GenerateTypeScriptCommand;
use Symfony\Component\Console\Application;

$application = new Application();

$application->addCommand(new GenerateTypeScriptCommand());
$application->addCommand(new GenerateReadmeCommand());
$application->addCommand(new GenerateFixturesCommand());

$application->run();